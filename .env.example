# ============================================================================
# VESTRA ERP - CONFIGURAÇÃO DE AMBIENTE (SUPABASE & NEXT.JS/VITE)
# ============================================================================

# URL do seu projeto Supabase (encontrado em Project Settings > API)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Chave Anônima Pública (Anon Key) (encontrado em Project Settings > API)
VITE_SUPABASE_ANON_KEY="your-anon-key-here"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Chaves Opcionais / Futuras (Apenas se utilizar Gemini AI ou integrações server-side)
GEMINI_API_KEY=""
